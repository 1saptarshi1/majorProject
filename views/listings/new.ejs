<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <h3>Create a new listing</h3>
    <form method="POST" action="/listings">
        <input type="text" name="listing[title]" placeholder="enter title">
        <br><br>
        <textarea type="text" name="lisring[description]" placeholder="enter discription"></textarea>
        <br><br>
        <input type="text" name="listing[Image]" placeholder="enter URL/link">
        <br><br>
        <input type="number" name="listing[price]" placeholder="enter price">
        <br><br>
        <input type="text" name="listing[country]" placeholder="enter country">
        <br><br>
        <input type="text" name="listing[location]" placeholder="enter location">
        <br><br>
        <button>Add</button>
    </form>
</body>
</html>